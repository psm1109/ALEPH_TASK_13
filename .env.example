PORT=3000
# YouTube Data API v3를 활성화한 프로젝트의 키. 검색과 링크 신청 검증에 필수입니다.
YOUTUBE_API_KEY=
# HTTPS 배포 시 1로 설정하세요.
COOKIE_SECURE=0
# Vercel에서는 필수. 로컬에서 둘 다 비우면 로컬 파일 저장소를 사용합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 선택: 동일 DB의 다른 앱과 데이터를 분리할 때 지정합니다.
# 기본값은 sai:v1:production / sai:v1:preview / sai:v1:development 입니다.
REDIS_KEY_PREFIX=
